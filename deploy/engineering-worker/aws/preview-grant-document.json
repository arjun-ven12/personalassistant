{
  "schemaVersion": "2.2",
  "description": "Finite scoped preview grant; no shell interpolation",
  "parameters": {"grant": {"type": "String", "interpolationType": "ENV_VAR", "allowedPattern": "^[A-Za-z0-9+/]{1,8190}={0,2}$"}},
  "mainSteps": [{
    "action": "aws:runShellScript",
    "name": "ScopedGrant",
    "inputs": {"timeoutSeconds": "20", "runCommand": ["/usr/local/bin/node /opt/athena/ec2-helper.js preview-grant"]}
  }]
}
