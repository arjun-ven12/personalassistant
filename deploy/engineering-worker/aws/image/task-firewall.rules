-N ATHENA-TASKS
-A ATHENA-TASKS -m conntrack --ctstate RELATED,ESTABLISHED -j ACCEPT
-A ATHENA-TASKS -s 172.29.0.2/32 -d 10.0.0.0/8 -j DROP
-A ATHENA-TASKS -s 172.29.0.2/32 -d 172.16.0.0/12 -j DROP
-A ATHENA-TASKS -s 172.29.0.2/32 -d 192.168.0.0/16 -j DROP
-A ATHENA-TASKS -s 172.29.0.2/32 -d 169.254.0.0/16 -j DROP
-A ATHENA-TASKS -s 172.29.0.2/32 -d 127.0.0.0/8 -j DROP
-A ATHENA-TASKS -s 172.29.0.2/32 -p tcp -m tcp --dport 443 -j ACCEPT
-A ATHENA-TASKS -s 172.30.0.0/24 -d 172.30.0.2/32 -p tcp -m tcp --dport 3128 -j ACCEPT
-A ATHENA-TASKS -s 172.31.0.0/24 -d 172.31.0.0/24 -p tcp -m tcp --dport 4173 -j ACCEPT
-A ATHENA-TASKS -s 172.16.0.0/12 -j DROP
-A ATHENA-TASKS -d 172.16.0.0/12 -j DROP
-A ATHENA-TASKS -j RETURN
