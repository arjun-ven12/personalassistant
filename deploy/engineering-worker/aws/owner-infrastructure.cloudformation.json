{
  "AWSTemplateFormatVersion": "2010-09-09",
  "Description": "Athena 28.4A owner infrastructure only. Existing resources reused. Preparation defaults deny worker egress and runtime IAM; no instance or worker trust is created.",
  "Parameters": {
    "VpcId": {
      "Type": "String",
      "Default": "vpc-04179b719aaccf907",
      "AllowedPattern": "vpc-[a-f0-9]{17}"
    },
    "SubnetA": {
      "Type": "String",
      "Default": "subnet-0c35a5bf3347d05ce",
      "AllowedPattern": "subnet-[a-f0-9]{17}"
    },
    "SubnetB": {
      "Type": "String",
      "Default": "subnet-0c6587bfbe480c38f",
      "AllowedPattern": "subnet-[a-f0-9]{17}"
    },
    "InternetGatewayId": {
      "Type": "String",
      "Default": "igw-0b96c42de697a4d46",
      "AllowedPattern": "igw-[a-f0-9]{17}"
    },
    "ExistingRouteTableId": {
      "Type": "String",
      "Default": "",
      "AllowedPattern": "(^$|rtb-[a-f0-9]{17})",
      "Description": "Owner has not created the route table. Leave empty to create routing and two subnet associations."
    },
    "PreviewDomain": {
      "Type": "String",
      "Default": "",
      "AllowedPattern": "(^$|[a-z0-9-]+(\\.[a-z0-9-]+)+)"
    },
    "HostedZoneId": {
      "Type": "String",
      "Default": "",
      "AllowedPattern": "(^$|Z[A-Z0-9]+)"
    },
    "ExistingCertificateArn": {
      "Type": "String",
      "Default": "",
      "AllowedPattern": "(^$|arn:aws:acm:ap-southeast-1:737073451069:certificate/[a-f0-9-]{36})"
    },
    "EnablePreview": {
      "Type": "String",
      "Default": "false",
      "AllowedValues": ["false", "true"],
      "Description": "Leave false without controlled domain/certificate. Update this same stack later."
    },
    "ActivateRuntimePermissions": {
      "Type": "String",
      "Default": "false",
      "AllowedValues": ["false", "true"],
      "Description": "Leave false. No worker image/helper evidence is reviewed yet."
    },
    "ReviewedAmiId": {
      "Type": "String",
      "Default": "",
      "AllowedPattern": "(^$|ami-[a-f0-9]{17})"
    },
    "ReviewedRuntimeDigest": {
      "Type": "String",
      "Default": "",
      "AllowedPattern": "(^$|[a-f0-9]{64})"
    },
    "ReviewedSupervisorHttpsCidr": {
      "Type": "String",
      "Default": "127.0.0.1/32",
      "AllowedPattern": "[0-9]{1,3}(\\.[0-9]{1,3}){3}/[0-9]{1,2}",
      "Description": "Loopback placeholder prevents worker egress. Only change to reviewed constrained supervisor HTTPS destination after security review."
    }
  },
  "Rules": {
    "ExpectedAccountAndRegion": {
      "Assertions": [
        {
          "Assert": {
            "Fn::And": [
              {
                "Fn::Equals": [
                  {
                    "Ref": "AWS::AccountId"
                  },
                  "737073451069"
                ]
              },
              {
                "Fn::Equals": [
                  {
                    "Ref": "AWS::Region"
                  },
                  "ap-southeast-1"
                ]
              }
            ]
          },
          "AssertDescription": "Deploy only in account 737073451069 / Singapore."
        }
      ]
    },
    "PreviewPrerequisites": {
      "RuleCondition": {
        "Fn::Equals": [
          {
            "Ref": "EnablePreview"
          },
          "true"
        ]
      },
      "Assertions": [
        {
          "Assert": {
            "Fn::Not": [
              {
                "Fn::Equals": [
                  {
                    "Ref": "PreviewDomain"
                  },
                  ""
                ]
              }
            ]
          },
          "AssertDescription": "Preview requires an owned domain."
        },
        {
          "Assert": {
            "Fn::Or": [
              {
                "Fn::Not": [
                  {
                    "Fn::Equals": [
                      {
                        "Ref": "ExistingCertificateArn"
                      },
                      ""
                    ]
                  }
                ]
              },
              {
                "Fn::Not": [
                  {
                    "Fn::Equals": [
                      {
                        "Ref": "HostedZoneId"
                      },
                      ""
                    ]
                  }
                ]
              }
            ]
          },
          "AssertDescription": "Provide an issued certificate or Route53 hosted zone for DNS validation."
        }
      ]
    },
    "RuntimePrerequisites": {
      "RuleCondition": {
        "Fn::Equals": [
          {
            "Ref": "ActivateRuntimePermissions"
          },
          "true"
        ]
      },
      "Assertions": [
        {
          "Assert": {
            "Fn::And": [
              {
                "Fn::Not": [
                  {
                    "Fn::Equals": [
                      {
                        "Ref": "ReviewedAmiId"
                      },
                      ""
                    ]
                  }
                ]
              },
              {
                "Fn::Not": [
                  {
                    "Fn::Equals": [
                      {
                        "Ref": "ReviewedRuntimeDigest"
                      },
                      ""
                    ]
                  }
                ]
              },
              {
                "Fn::Equals": [
                  {
                    "Ref": "EnablePreview"
                  },
                  "true"
                ]
              },
              {
                "Fn::Not": [
                  {
                    "Fn::Equals": [
                      {
                        "Ref": "ReviewedSupervisorHttpsCidr"
                      },
                      "127.0.0.1/32"
                    ]
                  }
                ]
              },
              {
                "Fn::Not": [
                  {
                    "Fn::Equals": [
                      {
                        "Ref": "ReviewedSupervisorHttpsCidr"
                      },
                      "0.0.0.0/0"
                    ]
                  }
                ]
              }
            ]
          },
          "AssertDescription": "Keep runtime disabled until reviewed image/digest, HTTPS preview, and constrained supervisor egress are approved."
        }
      ]
    }
  },
  "Conditions": {
    "CreateRouting": {
      "Fn::Equals": [
        {
          "Ref": "ExistingRouteTableId"
        },
        ""
      ]
    },
    "PreviewEnabled": {
      "Fn::Equals": [
        {
          "Ref": "EnablePreview"
        },
        "true"
      ]
    },
    "CreateCertificate": {
      "Fn::And": [
        {
          "Fn::Equals": [
            {
              "Ref": "EnablePreview"
            },
            "true"
          ]
        },
        {
          "Fn::Equals": [
            {
              "Ref": "ExistingCertificateArn"
            },
            ""
          ]
        }
      ]
    },
    "CreateDns": {
      "Fn::And": [
        {
          "Fn::Equals": [
            {
              "Ref": "EnablePreview"
            },
            "true"
          ]
        },
        {
          "Fn::Not": [
            {
              "Fn::Equals": [
                {
                  "Ref": "HostedZoneId"
                },
                ""
              ]
            }
          ]
        }
      ]
    },
    "RuntimeEnabled": {
      "Fn::Equals": [
        {
          "Ref": "ActivateRuntimePermissions"
        },
        "true"
      ]
    }
  },
  "Resources": {
    "PublicRouteTable": {
      "Type": "AWS::EC2::RouteTable",
      "Properties": {
        "VpcId": {
          "Ref": "VpcId"
        },
        "Tags": [
          {
            "Key": "athena:company",
            "Value": "c2ac447f-0747-4b78-80f1-2cc4fff8d82f"
          },
          {
            "Key": "Name",
            "Value": "athena-engineering-public-rt"
          }
        ]
      },
      "Condition": "CreateRouting"
    },
    "InternetRoute": {
      "Type": "AWS::EC2::Route",
      "Properties": {
        "RouteTableId": {
          "Ref": "PublicRouteTable"
        },
        "DestinationCidrBlock": "0.0.0.0/0",
        "GatewayId": {
          "Ref": "InternetGatewayId"
        }
      },
      "Condition": "CreateRouting"
    },
    "SubnetAssociationA": {
      "Type": "AWS::EC2::SubnetRouteTableAssociation",
      "Properties": {
        "RouteTableId": {
          "Ref": "PublicRouteTable"
        },
        "SubnetId": {
          "Ref": "SubnetA"
        }
      },
      "Condition": "CreateRouting"
    },
    "SubnetAssociationB": {
      "Type": "AWS::EC2::SubnetRouteTableAssociation",
      "Properties": {
        "RouteTableId": {
          "Ref": "PublicRouteTable"
        },
        "SubnetId": {
          "Ref": "SubnetB"
        }
      },
      "Condition": "CreateRouting"
    },
    "WorkerSecurityGroup": {
      "Type": "AWS::EC2::SecurityGroup",
      "Properties": {
        "GroupName": "athena-engineering-worker-sg",
        "GroupDescription": "Athena worker: ALB-only ingress and reviewed supervisor HTTPS egress",
        "VpcId": {
          "Ref": "VpcId"
        },
        "SecurityGroupEgress": [
          {
            "IpProtocol": "tcp",
            "FromPort": 443,
            "ToPort": 443,
            "CidrIp": {
              "Ref": "ReviewedSupervisorHttpsCidr"
            }
          }
        ],
        "Tags": [
          {
            "Key": "athena:company",
            "Value": "c2ac447f-0747-4b78-80f1-2cc4fff8d82f"
          }
        ]
      }
    },
    "PreviewSecurityGroup": {
      "Type": "AWS::EC2::SecurityGroup",
      "Properties": {
        "GroupName": "athena-engineering-preview-sg",
        "GroupDescription": "Athena preview HTTPS ingress; worker gate egress only",
        "VpcId": {
          "Ref": "VpcId"
        },
        "SecurityGroupIngress": [
          {
            "IpProtocol": "tcp",
            "FromPort": 443,
            "ToPort": 443,
            "CidrIp": "0.0.0.0/0"
          }
        ],
        "SecurityGroupEgress": [
          {
            "IpProtocol": "-1",
            "CidrIp": "127.0.0.1/32"
          }
        ],
        "Tags": [
          {
            "Key": "athena:company",
            "Value": "c2ac447f-0747-4b78-80f1-2cc4fff8d82f"
          }
        ]
      }
    },
    "WorkerGateIngress": {
      "Type": "AWS::EC2::SecurityGroupIngress",
      "Properties": {
        "GroupId": {
          "Ref": "WorkerSecurityGroup"
        },
        "IpProtocol": "tcp",
        "FromPort": 8080,
        "ToPort": 8080,
        "SourceSecurityGroupId": {
          "Ref": "PreviewSecurityGroup"
        }
      }
    },
    "PreviewGateEgress": {
      "Type": "AWS::EC2::SecurityGroupEgress",
      "Properties": {
        "GroupId": {
          "Ref": "PreviewSecurityGroup"
        },
        "IpProtocol": "tcp",
        "FromPort": 8080,
        "ToPort": 8080,
        "DestinationSecurityGroupId": {
          "Ref": "WorkerSecurityGroup"
        }
      }
    },
    "PreviewCertificate": {
      "Type": "AWS::CertificateManager::Certificate",
      "Properties": {
        "DomainName": {
          "Fn::Sub": "*.${PreviewDomain}"
        },
        "ValidationMethod": "DNS",
        "DomainValidationOptions": [
          {
            "DomainName": {
              "Fn::Sub": "*.${PreviewDomain}"
            },
            "HostedZoneId": {
              "Ref": "HostedZoneId"
            }
          }
        ],
        "Tags": [
          {
            "Key": "athena:company",
            "Value": "c2ac447f-0747-4b78-80f1-2cc4fff8d82f"
          }
        ]
      },
      "Condition": "CreateCertificate"
    },
    "PreviewLoadBalancer": {
      "Type": "AWS::ElasticLoadBalancingV2::LoadBalancer",
      "Properties": {
        "Name": "athena-engineering-preview",
        "Type": "application",
        "Scheme": "internet-facing",
        "IpAddressType": "ipv4",
        "Subnets": [
          {
            "Ref": "SubnetA"
          },
          {
            "Ref": "SubnetB"
          }
        ],
        "SecurityGroups": [
          {
            "Ref": "PreviewSecurityGroup"
          }
        ],
        "LoadBalancerAttributes": [
          {
            "Key": "routing.http.drop_invalid_header_fields.enabled",
            "Value": "true"
          },
          {
            "Key": "routing.http.desync_mitigation_mode",
            "Value": "strictest"
          },
          {
            "Key": "access_logs.s3.enabled",
            "Value": "false"
          }
        ],
        "Tags": [
          {
            "Key": "athena:company",
            "Value": "c2ac447f-0747-4b78-80f1-2cc4fff8d82f"
          }
        ]
      },
      "Condition": "PreviewEnabled"
    },
    "PreviewListener": {
      "Type": "AWS::ElasticLoadBalancingV2::Listener",
      "Properties": {
        "LoadBalancerArn": {
          "Ref": "PreviewLoadBalancer"
        },
        "Port": 443,
        "Protocol": "HTTPS",
        "SslPolicy": "ELBSecurityPolicy-TLS13-1-2-2021-06",
        "Certificates": [
          {
            "CertificateArn": {
              "Fn::If": [
                "CreateCertificate",
                {
                  "Ref": "PreviewCertificate"
                },
                {
                  "Ref": "ExistingCertificateArn"
                }
              ]
            }
          }
        ],
        "DefaultActions": [
          {
            "Type": "fixed-response",
            "FixedResponseConfig": {
              "StatusCode": "403",
              "ContentType": "text/plain",
              "MessageBody": "Preview authorization required."
            }
          }
        ]
      },
      "Condition": "PreviewEnabled"
    },
    "PreviewDns": {
      "Type": "AWS::Route53::RecordSet",
      "Properties": {
        "HostedZoneId": {
          "Ref": "HostedZoneId"
        },
        "Name": {
          "Fn::Sub": "*.${PreviewDomain}"
        },
        "Type": "A",
        "AliasTarget": {
          "DNSName": {
            "Fn::GetAtt": ["PreviewLoadBalancer", "DNSName"]
          },
          "HostedZoneId": {
            "Fn::GetAtt": ["PreviewLoadBalancer", "CanonicalHostedZoneID"]
          },
          "EvaluateTargetHealth": false
        }
      },
      "Condition": "CreateDns"
    },
    "ReaperRuntimePolicy": {
      "Type": "AWS::IAM::ManagedPolicy",
      "Properties": {
        "PolicyDocument": {
          "Version": "2012-10-17",
          "Statement": [
            {
              "Effect": "Allow",
              "Action": "ec2:TerminateInstances",
              "Resource": {
                "Fn::Sub": [
                  "arn:aws:ec2:ap-southeast-1:${ACCOUNT_ID}:instance/*",
                  {
                    "ACCOUNT_ID": "737073451069"
                  }
                ]
              },
              "Condition": {
                "StringEquals": {
                  "ec2:ResourceTag/athena:company": {
                    "Fn::Sub": [
                      "${COMPANY_ID}",
                      {
                        "COMPANY_ID": "c2ac447f-0747-4b78-80f1-2cc4fff8d82f"
                      }
                    ]
                  },
                  "ec2:ResourceTag/athena:runtime": {
                    "Fn::Sub": [
                      "${RUNTIME_DIGEST}",
                      {
                        "RUNTIME_DIGEST": {
                          "Ref": "ReviewedRuntimeDigest"
                        }
                      }
                    ]
                  }
                }
              }
            }
          ]
        },
        "Roles": ["AthenaEngineeringReaper"],
        "ManagedPolicyName": "AthenaEngineeringReaperRuntimeV1"
      },
      "Condition": "RuntimeEnabled"
    },
    "ComputeRuntimePolicy": {
      "Type": "AWS::IAM::ManagedPolicy",
      "Condition": "RuntimeEnabled",
      "Properties": {
        "ManagedPolicyName": "AthenaEngineeringComputeRuntimeV1",
        "PolicyDocument": {
          "Version": "2012-10-17",
          "Statement": [
            {
              "Sid": "ReadResourceEvidence",
              "Effect": "Allow",
              "Action": [
                "ec2:DescribeImages",
                "ec2:DescribeInstances",
                "ec2:DescribeVolumes",
                "ec2:DescribeSecurityGroups"
              ],
              "Resource": "*",
              "Condition": {
                "StringEquals": {
                  "aws:RequestedRegion": "ap-southeast-1"
                }
              }
            },
            {
              "Sid": "UseReviewedImageAndNetwork",
              "Effect": "Allow",
              "Action": "ec2:RunInstances",
              "Resource": [
                {
                  "Fn::Sub": [
                    "arn:aws:ec2:ap-southeast-1::image/${AMI_ID}",
                    {
                      "AMI_ID": {
                        "Ref": "ReviewedAmiId"
                      }
                    }
                  ]
                },
                {
                  "Fn::Sub": [
                    "arn:aws:ec2:ap-southeast-1:${ACCOUNT_ID}:subnet/${SUBNET_ID}",
                    {
                      "ACCOUNT_ID": "737073451069",
                      "SUBNET_ID": {
                        "Ref": "SubnetA"
                      }
                    }
                  ]
                },
                {
                  "Fn::Sub": [
                    "arn:aws:ec2:ap-southeast-1:${ACCOUNT_ID}:security-group/${WORKER_SG_ID}",
                    {
                      "ACCOUNT_ID": "737073451069",
                      "WORKER_SG_ID": {
                        "Ref": "WorkerSecurityGroup"
                      }
                    }
                  ]
                },
                {
                  "Fn::Sub": [
                    "arn:aws:ec2:ap-southeast-1:${ACCOUNT_ID}:network-interface/*",
                    {
                      "ACCOUNT_ID": "737073451069"
                    }
                  ]
                }
              ]
            },
            {
              "Sid": "CreateBoundedCompanyInstance",
              "Effect": "Allow",
              "Action": "ec2:RunInstances",
              "Resource": {
                "Fn::Sub": [
                  "arn:aws:ec2:ap-southeast-1:${ACCOUNT_ID}:instance/*",
                  {
                    "ACCOUNT_ID": "737073451069"
                  }
                ]
              },
              "Condition": {
                "StringEquals": {
                  "ec2:InstanceType": "t3.medium",
                  "aws:RequestTag/athena:company": {
                    "Fn::Sub": [
                      "${COMPANY_ID}",
                      {
                        "COMPANY_ID": "c2ac447f-0747-4b78-80f1-2cc4fff8d82f"
                      }
                    ]
                  },
                  "aws:RequestTag/athena:runtime": {
                    "Fn::Sub": [
                      "${RUNTIME_DIGEST}",
                      {
                        "RUNTIME_DIGEST": {
                          "Ref": "ReviewedRuntimeDigest"
                        }
                      }
                    ]
                  },
                  "ec2:InstanceProfile": {
                    "Fn::Sub": [
                      "arn:aws:iam::${ACCOUNT_ID}:instance-profile/${WORKER_ROLE_NAME}",
                      {
                        "ACCOUNT_ID": "737073451069",
                        "WORKER_ROLE_NAME": "AthenaEngineeringWorker"
                      }
                    ]
                  },
                  "ec2:MetadataHttpTokens": "required"
                },
                "NumericLessThanEquals": {
                  "ec2:MetadataHttpPutResponseHopLimit": "1"
                }
              }
            },
            {
              "Sid": "CreateCompanyVolume",
              "Effect": "Allow",
              "Action": "ec2:RunInstances",
              "Resource": {
                "Fn::Sub": [
                  "arn:aws:ec2:ap-southeast-1:${ACCOUNT_ID}:volume/*",
                  {
                    "ACCOUNT_ID": "737073451069"
                  }
                ]
              },
              "Condition": {
                "StringEquals": {
                  "aws:RequestTag/athena:company": {
                    "Fn::Sub": [
                      "${COMPANY_ID}",
                      {
                        "COMPANY_ID": "c2ac447f-0747-4b78-80f1-2cc4fff8d82f"
                      }
                    ]
                  },
                  "aws:RequestTag/athena:runtime": {
                    "Fn::Sub": [
                      "${RUNTIME_DIGEST}",
                      {
                        "RUNTIME_DIGEST": {
                          "Ref": "ReviewedRuntimeDigest"
                        }
                      }
                    ]
                  }
                },
                "NumericLessThanEquals": {
                  "ec2:VolumeSize": "10"
                },
                "Bool": {
                  "ec2:Encrypted": "true"
                }
              }
            },
            {
              "Sid": "TagOnlyAtLaunch",
              "Effect": "Allow",
              "Action": "ec2:CreateTags",
              "Resource": [
                {
                  "Fn::Sub": [
                    "arn:aws:ec2:ap-southeast-1:${ACCOUNT_ID}:instance/*",
                    {
                      "ACCOUNT_ID": "737073451069"
                    }
                  ]
                },
                {
                  "Fn::Sub": [
                    "arn:aws:ec2:ap-southeast-1:${ACCOUNT_ID}:volume/*",
                    {
                      "ACCOUNT_ID": "737073451069"
                    }
                  ]
                }
              ],
              "Condition": {
                "StringEquals": {
                  "ec2:CreateAction": "RunInstances",
                  "aws:RequestTag/athena:company": {
                    "Fn::Sub": [
                      "${COMPANY_ID}",
                      {
                        "COMPANY_ID": "c2ac447f-0747-4b78-80f1-2cc4fff8d82f"
                      }
                    ]
                  }
                }
              }
            },
            {
              "Sid": "StopDestroyOnlyCompanyInstances",
              "Effect": "Allow",
              "Action": ["ec2:StopInstances", "ec2:TerminateInstances"],
              "Resource": {
                "Fn::Sub": [
                  "arn:aws:ec2:ap-southeast-1:${ACCOUNT_ID}:instance/*",
                  {
                    "ACCOUNT_ID": "737073451069"
                  }
                ]
              },
              "Condition": {
                "StringEquals": {
                  "ec2:ResourceTag/athena:company": {
                    "Fn::Sub": [
                      "${COMPANY_ID}",
                      {
                        "COMPANY_ID": "c2ac447f-0747-4b78-80f1-2cc4fff8d82f"
                      }
                    ]
                  },
                  "ec2:ResourceTag/athena:runtime": {
                    "Fn::Sub": [
                      "${RUNTIME_DIGEST}",
                      {
                        "RUNTIME_DIGEST": {
                          "Ref": "ReviewedRuntimeDigest"
                        }
                      }
                    ]
                  }
                }
              }
            },
            {
              "Sid": "PassOnlyWorkerRole",
              "Effect": "Allow",
              "Action": "iam:PassRole",
              "Resource": {
                "Fn::Sub": [
                  "arn:aws:iam::${ACCOUNT_ID}:role/${WORKER_ROLE_NAME}",
                  {
                    "ACCOUNT_ID": "737073451069",
                    "WORKER_ROLE_NAME": "AthenaEngineeringWorker"
                  }
                ]
              },
              "Condition": {
                "StringEquals": {
                  "iam:PassedToService": "ec2.amazonaws.com"
                }
              }
            },
            {
              "Sid": "PassOnlyReaperRole",
              "Effect": "Allow",
              "Action": "iam:PassRole",
              "Resource": {
                "Fn::Sub": [
                  "arn:aws:iam::${ACCOUNT_ID}:role/${REAPER_ROLE_NAME}",
                  {
                    "ACCOUNT_ID": "737073451069",
                    "REAPER_ROLE_NAME": "AthenaEngineeringReaper"
                  }
                ]
              },
              "Condition": {
                "StringEquals": {
                  "iam:PassedToService": "scheduler.amazonaws.com"
                }
              }
            },
            {
              "Sid": "PinnedSsmDocuments",
              "Effect": "Allow",
              "Action": "ssm:SendCommand",
              "Resource": [
                {
                  "Fn::Sub": [
                    "arn:aws:ssm:ap-southeast-1:${ACCOUNT_ID}:document/AthenaEngineeringEvidenceV1",
                    {
                      "ACCOUNT_ID": "737073451069"
                    }
                  ]
                },
                {
                  "Fn::Sub": [
                    "arn:aws:ssm:ap-southeast-1:${ACCOUNT_ID}:document/AthenaEngineeringPreviewGrantV1",
                    {
                      "ACCOUNT_ID": "737073451069"
                    }
                  ]
                }
              ]
            },
            {
              "Sid": "CompanySsmTargets",
              "Effect": "Allow",
              "Action": "ssm:SendCommand",
              "Resource": {
                "Fn::Sub": [
                  "arn:aws:ec2:ap-southeast-1:${ACCOUNT_ID}:instance/*",
                  {
                    "ACCOUNT_ID": "737073451069"
                  }
                ]
              },
              "Condition": {
                "StringEquals": {
                  "ssm:resourceTag/athena:company": {
                    "Fn::Sub": [
                      "${COMPANY_ID}",
                      {
                        "COMPANY_ID": "c2ac447f-0747-4b78-80f1-2cc4fff8d82f"
                      }
                    ]
                  }
                }
              }
            },
            {
              "Sid": "ReadFiniteCommandResult",
              "Effect": "Allow",
              "Action": "ssm:GetCommandInvocation",
              "Resource": "*",
              "Condition": {
                "StringEquals": {
                  "aws:RequestedRegion": "ap-southeast-1"
                }
              }
            },
            {
              "Sid": "DenyGenericShellAndSessions",
              "Effect": "Deny",
              "Action": [
                "ssm:StartSession",
                "ssm:ResumeSession",
                "ssm:StartAutomationExecution"
              ],
              "Resource": "*"
            },
            {
              "Sid": "DenyGenericShellDocuments",
              "Effect": "Deny",
              "Action": "ssm:SendCommand",
              "Resource": [
                "arn:aws:ssm:ap-southeast-1::document/AWS-RunShellScript",
                "arn:aws:ssm:ap-southeast-1::document/AWS-RunPowerShellScript",
                "arn:aws:ssm:ap-southeast-1::document/AWS-RunRemoteScript"
              ]
            },
            {
              "Sid": "WorkspaceDeadlineSchedules",
              "Effect": "Allow",
              "Action": ["scheduler:CreateSchedule", "scheduler:GetSchedule"],
              "Resource": {
                "Fn::Sub": [
                  "arn:aws:scheduler:ap-southeast-1:${ACCOUNT_ID}:schedule/${SCHEDULE_GROUP}/athena-*",
                  {
                    "ACCOUNT_ID": "737073451069",
                    "SCHEDULE_GROUP": "athena-engineering-default-company"
                  }
                ]
              }
            }
          ]
        },
        "Users": ["athena-engineering"]
      }
    },
    "PreviewRuntimePolicy": {
      "Type": "AWS::IAM::ManagedPolicy",
      "Condition": "RuntimeEnabled",
      "Properties": {
        "ManagedPolicyName": "AthenaEngineeringPreviewRuntimeV1",
        "PolicyDocument": {
          "Version": "2012-10-17",
          "Statement": [
            {
              "Sid": "ReadReviewedIngress",
              "Effect": "Allow",
              "Action": [
                "elasticloadbalancing:DescribeListeners",
                "elasticloadbalancing:DescribeRules",
                "elasticloadbalancing:DescribeTargetGroups"
              ],
              "Resource": "*",
              "Condition": {
                "StringEquals": {
                  "aws:RequestedRegion": "ap-southeast-1"
                }
              }
            },
            {
              "Sid": "CreateTaggedTaskIngress",
              "Effect": "Allow",
              "Action": "elasticloadbalancing:CreateTargetGroup",
              "Resource": {
                "Fn::Sub": [
                  "arn:aws:elasticloadbalancing:ap-southeast-1:${ACCOUNT_ID}:targetgroup/athena-*/*",
                  {
                    "ACCOUNT_ID": "737073451069"
                  }
                ]
              },
              "Condition": {
                "StringEquals": {
                  "aws:RequestTag/athena:company": {
                    "Fn::Sub": [
                      "${COMPANY_ID}",
                      {
                        "COMPANY_ID": "c2ac447f-0747-4b78-80f1-2cc4fff8d82f"
                      }
                    ]
                  }
                }
              }
            },
            {
              "Sid": "ManageTaskTargets",
              "Effect": "Allow",
              "Action": [
                "elasticloadbalancing:RegisterTargets",
                "elasticloadbalancing:DeleteTargetGroup"
              ],
              "Resource": {
                "Fn::Sub": [
                  "arn:aws:elasticloadbalancing:ap-southeast-1:${ACCOUNT_ID}:targetgroup/athena-*/*",
                  {
                    "ACCOUNT_ID": "737073451069"
                  }
                ]
              },
              "Condition": {
                "StringEquals": {
                  "elasticloadbalancing:ResourceTag/athena:company": {
                    "Fn::Sub": [
                      "${COMPANY_ID}",
                      {
                        "COMPANY_ID": "c2ac447f-0747-4b78-80f1-2cc4fff8d82f"
                      }
                    ]
                  }
                }
              }
            },
            {
              "Sid": "CreateReviewedListenerRule",
              "Effect": "Allow",
              "Action": "elasticloadbalancing:CreateRule",
              "Resource": {
                "Fn::Sub": [
                  "${LISTENER_ARN}",
                  {
                    "LISTENER_ARN": {
                      "Ref": "PreviewListener"
                    }
                  }
                ]
              },
              "Condition": {
                "StringEquals": {
                  "aws:RequestTag/athena:company": {
                    "Fn::Sub": [
                      "${COMPANY_ID}",
                      {
                        "COMPANY_ID": "c2ac447f-0747-4b78-80f1-2cc4fff8d82f"
                      }
                    ]
                  }
                }
              }
            },
            {
              "Sid": "RevokeTaskRule",
              "Effect": "Allow",
              "Action": "elasticloadbalancing:DeleteRule",
              "Resource": {
                "Fn::Sub": [
                  "${LISTENER_RULE_ARN_PREFIX}*",
                  {
                    "LISTENER_RULE_ARN_PREFIX": {
                      "Fn::Join": [
                        "",
                        [
                          {
                            "Fn::Select": [
                              0,
                              {
                                "Fn::Split": [
                                  ":listener/",
                                  {
                                    "Ref": "PreviewListener"
                                  }
                                ]
                              }
                            ]
                          },
                          ":listener-rule/",
                          {
                            "Fn::Select": [
                              1,
                              {
                                "Fn::Split": [
                                  ":listener/",
                                  {
                                    "Ref": "PreviewListener"
                                  }
                                ]
                              }
                            ]
                          },
                          "/"
                        ]
                      ]
                    }
                  }
                ]
              },
              "Condition": {
                "StringEquals": {
                  "elasticloadbalancing:ResourceTag/athena:company": {
                    "Fn::Sub": [
                      "${COMPANY_ID}",
                      {
                        "COMPANY_ID": "c2ac447f-0747-4b78-80f1-2cc4fff8d82f"
                      }
                    ]
                  }
                }
              }
            },
            {
              "Sid": "TagTargetOnlyAtCreation",
              "Effect": "Allow",
              "Action": "elasticloadbalancing:AddTags",
              "Resource": {
                "Fn::Sub": [
                  "arn:aws:elasticloadbalancing:ap-southeast-1:${ACCOUNT_ID}:targetgroup/athena-*/*",
                  {
                    "ACCOUNT_ID": "737073451069"
                  }
                ]
              },
              "Condition": {
                "StringEquals": {
                  "aws:RequestTag/athena:company": {
                    "Fn::Sub": [
                      "${COMPANY_ID}",
                      {
                        "COMPANY_ID": "c2ac447f-0747-4b78-80f1-2cc4fff8d82f"
                      }
                    ]
                  },
                  "elasticloadbalancing:CreateAction": "CreateTargetGroup"
                }
              }
            },
            {
              "Sid": "TagRuleOnlyAtCreation",
              "Effect": "Allow",
              "Action": "elasticloadbalancing:AddTags",
              "Resource": {
                "Fn::Sub": [
                  "${LISTENER_RULE_ARN_PREFIX}*",
                  {
                    "LISTENER_RULE_ARN_PREFIX": {
                      "Fn::Join": [
                        "",
                        [
                          {
                            "Fn::Select": [
                              0,
                              {
                                "Fn::Split": [
                                  ":listener/",
                                  {
                                    "Ref": "PreviewListener"
                                  }
                                ]
                              }
                            ]
                          },
                          ":listener-rule/",
                          {
                            "Fn::Select": [
                              1,
                              {
                                "Fn::Split": [
                                  ":listener/",
                                  {
                                    "Ref": "PreviewListener"
                                  }
                                ]
                              }
                            ]
                          },
                          "/"
                        ]
                      ]
                    }
                  }
                ]
              },
              "Condition": {
                "StringEquals": {
                  "aws:RequestTag/athena:company": {
                    "Fn::Sub": [
                      "${COMPANY_ID}",
                      {
                        "COMPANY_ID": "c2ac447f-0747-4b78-80f1-2cc4fff8d82f"
                      }
                    ]
                  },
                  "elasticloadbalancing:CreateAction": "CreateRule"
                }
              }
            }
          ]
        },
        "Users": ["athena-engineering"]
      }
    }
  },
