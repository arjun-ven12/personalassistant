NODE_ENV=development
DEPLOYMENT_MODE=private
API_HOST=127.0.0.1
API_PORT=3001
# Container hosts commonly inject PORT.
# PORT=3001
# PUBLIC_BASE_URL=https://api.alexa.example
WEB_ORIGIN=http://localhost:5173
LOG_LEVEL=info
LOG_REDACTION_ENABLED=true
PRIVATE_NETWORK_REQUIRED=false
TAILSCALE_REQUIRED=false
NETWORK_VERIFIER_MODE=unknown
TAILSCALE_TRUST_SERVE_PROXY=false
TRUSTED_PROXY_MODE=none
ALLOWED_HOSTS=localhost,127.0.0.1
STORE_MODE=memory
# DATABASE_URL=postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require
DATABASE_POOL_SIZE=20
DATABASE_SSL_MODE=require

# Redis supports either Upstash REST or standard Redis.
# Upstash:
# REDIS_URL=https://example.upstash.io
# REDIS_TOKEN=replace-with-secret
# Standard Redis:
# REDIS_HOST=127.0.0.1
REDIS_PORT=6379
# REDIS_USERNAME=
# REDIS_PASSWORD=replace-with-secret
REDIS_TLS=true
REDIS_NAMESPACE=personalassistant
CACHE_ENABLED=false
CACHE_DEFAULT_TTL=900
CACHE_CONTEXT_TTL=300
CACHE_MEMORY_TTL=3600
CACHE_REPOSITORY_TTL=1800

EMBEDDING_PROVIDER=disabled
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_BATCH_SIZE=32
EMBEDDING_MAX_RETRIES=3
# OPENAI_API_KEY=replace-with-secret

MEMORY_ENABLED=true
MEMORY_RETRIEVAL_LIMIT=12
MEMORY_SIMILARITY_THRESHOLD=0.75
MEMORY_BACKGROUND_CONSOLIDATION=true
MEMORY_MAX_CONTEXT=40
KNOWLEDGE_GRAPH_ENABLED=true
KNOWLEDGE_GRAPH_AUTO_LINK=true
KNOWLEDGE_GRAPH_MAX_DEPTH=4
BACKGROUND_WORKERS=0
WORKER_CONCURRENCY=8
MEMORY_CONSOLIDATION_INTERVAL=300
SUMMARY_BATCH_SIZE=10
SEMANTIC_SEARCH_ENABLED=false
HYBRID_SEARCH_ENABLED=true
KEYWORD_WEIGHT=0.35
VECTOR_WEIGHT=0.65
MEMORY_METRICS=true
CACHE_METRICS=true
VECTOR_METRICS=true
REDIS_METRICS=true
FEATURE_MEMORY=true
FEATURE_VECTOR_SEARCH=false
FEATURE_AGENT_MEMORY=true
FEATURE_MEMORY_TIMELINE=true
FEATURE_KNOWLEDGE_GRAPH=true
FEATURE_AUTONOMOUS_SUGGESTIONS=false

AUTH_ALLOW_OWNER_BOOTSTRAP=true
SESSION_COOKIE_NAME=alexa_session
SESSION_TTL_SECONDS=28800
SESSION_IDLE_TTL_SECONDS=1800
SESSION_ABSOLUTE_TTL_SECONDS=28800
CSRF_TOKEN_TTL_SECONDS=900
RECENT_AUTH_TTL_SECONDS=300
RECOVERY_CODE_COUNT=10
PAIRING_TTL_SECONDS=300
SIGNED_REQUEST_TOLERANCE_SECONDS=120
PRIVILEGED_EXECUTION_ENABLED=false
READ_ONLY_EXECUTION_ENABLED=false
EXECUTION_REQUEST_TTL_SECONDS=120
EXECUTION_RESULT_RETENTION_SECONDS=86400
MAX_FILE_READ_BYTES=131072
MAX_GIT_OUTPUT_BYTES=262144
MAX_GIT_ENTRIES=1000
MAX_EXECUTION_RESULT_BYTES=524288
SERVER_EXECUTION_SIGNING_KEY_PATH=.local/server-execution-key.json

# Google OAuth remains structure-only until a reviewed provider integration.
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GOOGLE_REDIRECT_URI=http://localhost:3001/api/auth/google/callback

# Android push uses FCM HTTP v1 with server-side Application Default
# Credentials. Never place the service-account credential in the Android app.
# FCM_PROJECT_ID=alexa-production

# Local AI is optional and fail-closed when Ollama is unavailable.
LOCAL_AI_ENABLED=true
LOCAL_AI_RUNTIME=ollama
OLLAMA_BASE_URL=http://127.0.0.1:11434
LOCAL_AI_DEFAULT_MODEL=gemma3:4b
LOCAL_AI_MAX_CONCURRENT_REQUESTS=1
LOCAL_AI_INTERPRETATION_TIMEOUT_MS=15000
LOCAL_AI_CONVERSATION_TIMEOUT_MS=45000
LOCAL_AI_BACKGROUND_TIMEOUT_MS=120000
LOCAL_AI_STRUCTURED_RETRIES=1
LOCAL_AI_IDLE_UNLOAD_MINUTES=10
LOCAL_AI_MIN_FREE_STORAGE_GB=10
LOCAL_AI_CONTEXT_MAX_CHARACTERS=16000
OPENAI_ENABLED=false
# OPENAI_API_KEY=replace-with-secret
OPENAI_DEFAULT_MODEL=gpt-5.6-luna
OPENAI_BASE_URL=https://api.openai.com/v1
AI_ROLE_FAST_INTERPRETER_PROVIDER=ollama
AI_ROLE_FAST_INTERPRETER_MODEL=gemma3:4b
AI_ROLE_GENERAL_REASONER_PROVIDER=openai
AI_ROLE_GENERAL_REASONER_MODEL=gpt-5.6-luna
AI_ROLE_WRITER_PROVIDER=openai
AI_ROLE_WRITER_MODEL=gpt-5.6-luna
AI_ROLE_CODER_PROVIDER=openai
AI_ROLE_CODER_MODEL=gpt-5.6-luna
AI_ROLE_DEEP_REASONER_PROVIDER=openai
AI_ROLE_DEEP_REASONER_MODEL=gpt-5.6-luna
