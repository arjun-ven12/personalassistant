:{$PORT:4173} {
  encode zstd gzip

  @runtime_config path /runtime-config.js
  header @runtime_config Cache-Control "no-store"

  handle /api/* {
    reverse_proxy {$VITE_API_BASE_URL} {
      header_up Host {upstream_hostport}
    }
  }

  handle /health {
    reverse_proxy {$VITE_API_BASE_URL} {
      header_up Host {upstream_hostport}
    }
  }

  handle {
    root * /srv
    try_files {path} /index.html
    file_server
  }
}
