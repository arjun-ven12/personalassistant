<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
  android:layout_width="match_parent"
  android:layout_height="match_parent"
  android:background="@drawable/widget_background"
  android:orientation="vertical"
  android:padding="14dp">

  <LinearLayout
    android:layout_width="match_parent"
    android:layout_height="42dp"
    android:gravity="center_vertical"
    android:orientation="horizontal">

    <ImageView
      android:layout_width="34dp"
      android:layout_height="34dp"
      android:contentDescription="@string/app_name"
      android:src="@mipmap/ic_launcher" />

    <TextView
      android:layout_width="0dp"
      android:layout_height="wrap_content"
      android:layout_marginStart="9dp"
      android:layout_weight="1"
      android:text="Monday OS"
      android:textColor="#F4F6FB"
      android:textSize="16sp"
      android:textStyle="bold" />

    <ImageButton
      android:id="@+id/widget_mic"
      android:layout_width="42dp"
      android:layout_height="42dp"
      android:background="@drawable/widget_mic_background"
      android:contentDescription="Open Athena Voice"
      android:padding="10dp"
      android:src="@drawable/widget_mic" />
  </LinearLayout>

  <LinearLayout
    android:layout_width="match_parent"
    android:layout_height="42dp"
    android:layout_marginTop="8dp"
    android:background="@drawable/widget_metric_background"
    android:gravity="center"
    android:orientation="horizontal">

    <TextView
      android:id="@+id/widget_active_count"
      android:layout_width="wrap_content"
      android:layout_height="wrap_content"
      android:text="0"
      android:textColor="#55D6AF"
      android:textSize="17sp"
      android:textStyle="bold" />

    <TextView
      android:layout_width="wrap_content"
      android:layout_height="wrap_content"
      android:layout_marginStart="6dp"
      android:text="ACTIVE"
      android:textColor="#AEB8C8"
      android:textSize="10sp" />

    <TextView
      android:layout_width="1dp"
      android:layout_height="20dp"
      android:layout_marginHorizontal="18dp"
      android:background="#343B49" />

    <TextView
      android:id="@+id/widget_dormant_count"
      android:layout_width="wrap_content"
      android:layout_height="wrap_content"
      android:text="0"
      android:textColor="#9DB6FF"
      android:textSize="17sp"
      android:textStyle="bold" />

    <TextView
      android:layout_width="wrap_content"
      android:layout_height="wrap_content"
      android:layout_marginStart="6dp"
      android:text="DORMANT"
      android:textColor="#AEB8C8"
      android:textSize="10sp" />
  </LinearLayout>

  <TextView
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="10dp"
    android:text="PENDING APPROVALS"
    android:textColor="#8993A5"
    android:textSize="10sp"
    android:textStyle="bold" />

  <FrameLayout
    android:layout_width="match_parent"
    android:layout_height="0dp"
    android:layout_marginTop="4dp"
    android:layout_weight="1">

    <ListView
      android:id="@+id/widget_approval_list"
      android:layout_width="match_parent"
      android:layout_height="match_parent"
      android:divider="@android:color/transparent"
      android:dividerHeight="4dp"
      android:scrollbars="none" />

    <TextView
      android:id="@+id/widget_approval_empty"
      android:layout_width="match_parent"
      android:layout_height="match_parent"
      android:gravity="center"
      android:text="No approvals pending"
      android:textColor="#8993A5"
      android:textSize="12sp" />
  </FrameLayout>
</LinearLayout>
