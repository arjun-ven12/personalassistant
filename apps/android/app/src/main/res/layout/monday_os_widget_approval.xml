<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
  android:id="@+id/widget_approval_row"
  android:layout_width="match_parent"
  android:layout_height="40dp"
  android:background="@drawable/widget_approval_background"
  android:gravity="center_vertical"
  android:orientation="horizontal"
  android:paddingHorizontal="10dp">

  <TextView
    android:id="@+id/widget_approval_summary"
    android:layout_width="0dp"
    android:layout_height="wrap_content"
    android:layout_weight="1"
    android:ellipsize="end"
    android:maxLines="1"
    android:textColor="#EDF1F8"
    android:textSize="12sp" />

  <TextView
    android:id="@+id/widget_approval_risk"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:layout_marginStart="8dp"
    android:textColor="#FFC766"
    android:textSize="9sp"
    android:textStyle="bold" />
</LinearLayout>
