ALEXA_API_BASE_URL=http://localhost:3001
# The authenticated Alexa Control UI used for owner approvals.
ALEXA_WEB_BASE_URL=http://localhost:5173
ALEXA_AGENT_LOG_LEVEL=info
# Local desktop transcription. The default paths are created by the pinned
# whisper.cpp setup described in docs/desktop-whisper-stt.md.
DESKTOP_STT_PROVIDER=whisper_cpp
DESKTOP_STT_FALLBACK_PROVIDER=apple_speech
DESKTOP_STT_WHISPER_MODEL_VERSION=ggml-base.en
DESKTOP_STT_WHISPER_THREADS=4
DESKTOP_STT_WHISPER_NO_SPEECH_THRESHOLD=0.25
# DESKTOP_STT_WHISPER_BINARY_PATH=/absolute/path/to/whisper-cli
# DESKTOP_STT_WHISPER_MODEL_PATH=/absolute/path/to/ggml-base.en.bin
ALEXA_REQUIRE_PRIVATE_NETWORK=true
# For a validated Phase 24 cloud runtime, use the canonical HTTPS API URL and
# set ALEXA_REQUIRE_PRIVATE_NETWORK=false. Device trust, Ed25519 signatures,
# expiry, nonce replay protection, target binding, policy, and approvals remain required.
ALEXA_READ_ONLY_EXECUTION_ENABLED=false
# ALEXA_SERVER_EXECUTION_PUBLIC_KEY=<pinned Ed25519 public JWK x value>
ALEXA_EXECUTION_POLL_INTERVAL_MS=5000
ALEXA_MAX_FILE_READ_BYTES=131072
ALEXA_MAX_GIT_OUTPUT_BYTES=262144
